generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String
  username        String    @unique
  password        String
  role            String    @default("member")
  photo_profile   String?   @default("https://picsum.photos/200")
  bio             String?   @default("Welcome to fitcuy")
  created_at      DateTime  @default(now())

  // PEMILIK workout (yang mengerjakan)
  workouts_user   Workout[] @relation("WorkoutsUser")

  // Pembuat/pengubah workout (bisa owner sendiri atau mentor)
  workouts_created Workout[] @relation("WorkoutsCreated")
  workouts_updated Workout[] @relation("WorkoutsUpdated")

  // Mentorship
  membersOf Mentorship[] @relation("MentorMentorships")
  mentorsOf Mentorship[] @relation("MemberMentorships")

  // Workout yang ditugaskan sebagai mentor
  assignedWorkouts Workout[] @relation("MentorAssignedWorkouts")

  @@map("users")
}

model Workout {
  id            Int       @id @default(autoincrement())
  exercise_id   Int
  duration      Int?
  exercise_date DateTime
  notes         String?   @default("")
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // PEMILIK workout (member yang mengerjakan)
  user_id       Int
  user          User      @relation("WorkoutsUser", fields: [user_id], references: [id])

  // Pembuat record (bisa owner sendiri ATAU mentor)
  created_by    Int
  createdByUser User      @relation("WorkoutsCreated", fields: [created_by], references: [id])

  // Pengubah terakhir
  updated_by     Int?
  updatedByUser  User?     @relation("WorkoutsUpdated", fields: [updated_by], references: [id])

  // Jenis olahraga
  sport          Sport     @relation(fields: [exercise_id], references: [id])

  // Mentor pemberi arahan (opsional)
  mentor_id      Int?
  mentor         User?     @relation("MentorAssignedWorkouts", fields: [mentor_id], references: [id])

  @@index([user_id])
  @@index([created_by])
  @@index([mentor_id])
  @@map("workouts")
}

model Sport {
  id            Int       @id @default(autoincrement())
  exercise_type String
  info          String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  workouts      Workout[]

  @@map("sports")
}

model Mentorship {
  id         Int      @id @default(autoincrement())
  mentorId   Int
  memberId   Int
  isActive   Boolean  @default(true)
  created_at DateTime @default(now())

  mentor     User     @relation("MentorMentorships", fields: [mentorId], references: [id], onDelete: Cascade)
  member     User     @relation("MemberMentorships", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([mentorId, memberId])
  @@index([mentorId])
  @@index([memberId])
  @@map("mentorships")
}